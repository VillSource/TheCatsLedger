{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=db/app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LineOptions": {
    "MetadataAddress": "https://access.line.me/.well-known/openid-configuration",
    "ValidIssuer": "https://access.line.me",
    "ValidAudience": "YOUR_LIFF_CHANNEL_ID",
    "ChannelAccessToken": "YOUR_CHANNEL_ACESSTOKEN",
    "LIFFID": "YOUR_LIFF_ID"
  }
}
